# MedMesh backend configuration. Every value here has a working default in
# app/config.py; this file documents the ones worth changing.

# --- Data layer ---------------------------------------------------------
# Pilot default is SQLite. For the topology in the architecture report:
# MEDMESH_DATABASE_URL=postgresql+psycopg://medmesh:secret@localhost:5432/medmesh
MEDMESH_DATABASE_URL=sqlite+pysqlite:///./medmesh.db
MEDMESH_SQL_ECHO=false

# --- Auth ---------------------------------------------------------------
# MUST be replaced before any deployment. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MEDMESH_JWT_SECRET=dev-only-secret-change-me-in-production
MEDMESH_ACCESS_TOKEN_TTL_MINUTES=720

# --- Trust engine -------------------------------------------------------
MEDMESH_FRESHNESS_LIVE_MINUTES=15
MEDMESH_FRESHNESS_WARM_MINUTES=60
MEDMESH_FRESHNESS_STALE_MINUTES=240
MEDMESH_ANOMALY_ABS_DELTA=12
MEDMESH_ANOMALY_PCT_DELTA=0.45

# --- Dispatch -----------------------------------------------------------
MEDMESH_DEFAULT_HOLD_TTL_SECONDS=900
MEDMESH_URBAN_SPEED_KMPH=34

# --- Road routing --------------------------------------------------------
# Server-side Google Distance Matrix key, restricted by IP. Deliberately a
# DIFFERENT key from the browser's EXPO_PUBLIC_GOOGLE_MAPS_API_KEY: the
# browser key must be public to work, and a public key with Distance Matrix
# enabled is an open billing account. Without it, ranking falls back to the
# geometric estimate and every ETA is labelled as one.
# MEDMESH_GOOGLE_MAPS_SERVER_KEY=
MEDMESH_ROUTING_ENABLED=true
MEDMESH_ROUTING_TIMEOUT_SECONDS=4.0

# --- Demo feed ----------------------------------------------------------
# Drives the ingest simulator so dashboards move. Set false in production.
MEDMESH_SIMULATOR_ENABLED=true
MEDMESH_SIMULATOR_INTERVAL_SECONDS=3.5
# --- Pilot credentials ---------------------------------------------------
# When on, GET /auth/demo-accounts returns the seeded pilot sign-ins and the
# sign-in screen renders them. OFF by default: a deployment that forgets to
# configure this shows an empty sign-in screen rather than publishing an
# administrator's password. Never enable against a real facility's data.
MEDMESH_DEMO_MODE=true

# Echo a password-reset token in the reset response. Only meaningful with no
# mail transport configured, which is the pilot's situation.
MEDMESH_EXPOSE_PASSWORD_RESET_TOKEN=true
