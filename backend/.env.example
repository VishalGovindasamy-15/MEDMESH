# MedMesh backend configuration. Every value here has a working default in
# app/config.py; this file documents the ones worth changing.

# --- Data layer ---------------------------------------------------------
# Pilot default is SQLite. For the topology in the architecture report:
# MEDMESH_DATABASE_URL=postgresql+psycopg://medmesh:secret@localhost:5432/medmesh
MEDMESH_DATABASE_URL=sqlite+pysqlite:///./medmesh.db
MEDMESH_SQL_ECHO=false

# --- Auth ---------------------------------------------------------------
# MUST be replaced before any deployment. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MEDMESH_JWT_SECRET=dev-only-secret-change-me-in-production
MEDMESH_ACCESS_TOKEN_TTL_MINUTES=720

# --- Trust engine -------------------------------------------------------
MEDMESH_FRESHNESS_LIVE_MINUTES=15
MEDMESH_FRESHNESS_WARM_MINUTES=60
MEDMESH_FRESHNESS_STALE_MINUTES=240
MEDMESH_ANOMALY_ABS_DELTA=12
MEDMESH_ANOMALY_PCT_DELTA=0.45

# --- Dispatch -----------------------------------------------------------
MEDMESH_DEFAULT_HOLD_TTL_SECONDS=900
MEDMESH_URBAN_SPEED_KMPH=34

# --- Demo feed ----------------------------------------------------------
# Drives the ingest simulator so dashboards move. Set false in production.
MEDMESH_SIMULATOR_ENABLED=true
MEDMESH_SIMULATOR_INTERVAL_SECONDS=3.5
